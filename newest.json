uthor":false,"tags":["performance"],"short_id_url":"https://lobste.rs/s/9xcc2g","comments_url":"https://lobste.rs/s/9xcc2g/vectorized_clz_ctz"},{"short_id":"sriqip","created_at":"2026-10-09T12:23:45.854-05:00","title":"Two Futures for LLMs in Mathematics","url":"https://wiredream.com/llm-two-futures/","score":4,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"dga","user_is_author":true,"tags":["math","vibecoding"],"short_id_url":"https://lobste.rs/s/sriqip","comments_url":"https://lobste.rs/s/sriqip/two_futures_for_llms_mathematics"},{"short_id":"rpiwtb","created_at":"2026-10-09T12:07:02.641-05:00","title":"Python 3.15.0","url":"https://www.python.org/downloads/release/python-3150/","score":30,"flags":0,"comment_count":1,"description":"","description_plain":"","submitter_user":"kaycebasques","user_is_author":false,"tags":["python","release"],"short_id_url":"https://lobste.rs/s/rpiwtb","comments_url":"https://lobste.rs/s/rpiwtb/python_3_15_0"},{"short_id":"zubabn","created_at":"2026-10-09T10:32:51.176-05:00","title":"Unison Cloud is now open source","url":"https://www.unison-lang.org/blog/unison-cloud-open-source/","score":37,"flags":0,"comment_count":2,"description":"","description_plain":"","submitter_user":"bontaq","user_is_author":false,"tags":["release"],"short_id_url":"https://lobste.rs/s/zubabn","comments_url":"https://lobste.rs/s/zubabn/unison_cloud_is_now_open_source"},{"short_id":"aqdswf","created_at":"2026-10-09T10:03:06.773-05:00","title":"Artificial Intelligence in the Firm: Bottlenecks in Software Production","url":"https://fion.ac/jellyfish.pdf","score":1,"flags":0,"comment_count":0,"description":"\u003cp\u003eWe study the impacts of AI coding assistants and agents on software engineering work, using a novel proprietary dataset from an engineering analytics platform, covering 300 million work events — including GitHub coding activity, Jira issues, and Google Calendar events — across 718 firms. We use a staggered difference-in-differences design, exploiting variation in firm- level adoption timing of AI coding assistants and agents. Both technologies increase coding productivity. However, productivity gains do not fully pass through to changes in software output or employment. For AI agents, this incomplete pass-through reflects a bottleneck from code review: review times increase, a larger share of code updates require revisions, and reviews involve more comments. We develop a model of software production to structure these results, in which AI affects both productivity and quality of intermediate outputs, and in turn can generate a review bottleneck and limit pass-through.\u003c/p\u003e\n","description_plain":"We study the impacts of AI coding assistants and agents on software engineering work, using a novel proprietary dataset from an engineering analytics platform, covering 300 million work events — including GitHub coding activity, Jira issues, and Google Calendar events — across 718 firms. We use a staggered difference-in-differences design, exploiting variation in firm- level adoption timing of AI coding assistants and agents. Both technologies increase coding productivity. However, productivity gains do not fully pass through to changes in software output or employment. For AI agents, this incomplete pass-through reflects a bottleneck from code review: review times increase, a larger share of code updates require revisions, and reviews involve more comments. We develop a model of software production to structure these results, in which AI affects both productivity and quality of intermediate outputs, and in turn can generate a review bottleneck and limit pass-through.","submitter_user":"mtset","user_is_author":false,"tags":["pdf","practices","vibecoding"],"short_id_url":"https://lobste.rs/s/aqdswf","comments_url":"https://lobste.rs/s/aqdswf/artificial_intelligence_firm"},{"short_id":"4dwrz0","created_at":"2026-10-09T09:30:28.326-05:00","title":"A tale of four theorem provers, or: A (reasonably) opinionated comparison of Isabelle/HOL, Lean, HOL4, and Agda","url":"https://blueberrywren.dev/blog/primes/","score":30,"flags":0,"comment_count":6,"description":"","description_plain":"","submitter_user":"blueberrywren","user_is_author":true,"tags":["design","plt"],"short_id_url":"https://lobste.rs/s/4dwrz0","comments_url":"https://lobste.rs/s/4dwrz0/tale_four_theorem_provers_reasonably"},{"short_id":"t5htlf","created_at":"2026-10-09T09:22:04.535-05:00","title":"Why Are Coding Agents So Dumb?","url":"https://mtlynch.io/why-are-coding-agents-so-dumb/","score":28,"flags":0,"comment_count":14,"description":"","description_plain":"","submitter_user":"mtlynch","user_is_author":true,"tags":["rant","vibecoding"],"short_id_url":"https://lobste.rs/s/t5htlf","comments_url":"https://lobste.rs/s/t5htlf/why_are_coding_agents_so_dumb"},{"short_id":"ha0qt7","created_at":"2026-10-09T09:14:17.771-05:00","title":"\"Robot\" Is A Social Construct: Why Your Dishwasher Is Not A Robot","url":"https://robotgirlgang.com/2026/10/08/robot-is-a-social-construct-why-your-dishwasher-is-not-a-robot/","score":13,"flags":0,"comment_count":4,"description":"","description_plain":"","submitter_user":"icefox","user_is_author":false,"tags":["philosophy"],"short_id_url":"https://lobste.rs/s/ha0qt7","comments_url":"https://lobste.rs/s/ha0qt7/robot_is_social_construct_why_your"},{"short_id":"pmzbuu","created_at":"2026-10-09T08:56:41.173-05:00","title":"Deepthi Sigireddi from Supabase","url":"https://theconsensus.dev/p/2026/10/08/deepthi-sigireddi-from-supabase.html","score":11,"flags":0,"comment_count":1,"description":"","description_plain":"","submitter_user":"eatonphil","user_is_author":true,"tags":["databases","person"],"short_id_url":"https://lobste.rs/s/pmzbuu","comments_url":"https://lobste.rs/s/pmzbuu/deepthi_sigireddi_from_supabase"},{"short_id":"8mj9bb","created_at":"2026-10-09T08:33:23.334-05:00","title":"Spinlocks Considered Harmful (2020)","url":"https://matklad.githu