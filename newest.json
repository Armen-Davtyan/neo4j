[{"short_id":"vmmq7g","created_at":"2026-09-30T02:47:04.435-05:00","title":"OpenBSD's ports tree keeps GPL coreutils and rejects uutils (Rust rewrite)","url":"https://www.mail-archive.com/ports%40openbsd.org/msg143892.html","score":1,"flags":0,"comment_count":0,"description":"\u003cp\u003eA contributor proposed a new OpenBSD port for uutils, the Rust reimplementations of GNU coreutils. The proposal met firm resistance: Stuart Henderson called it unusable, explaining that GNU coreutils exists mainly to stabilize GNU-sensitive build environments. Theo de Raadt went further arguing that nobody wants subtly differently-behaving utilities in their pipelines and that ports developers would be stuck maintaining the result.\u003c/p\u003e\n","description_plain":"A contributor proposed a new OpenBSD port for uutils, the Rust reimplementations of GNU coreutils. The proposal met firm resistance: Stuart Henderson called it unusable, explaining that GNU coreutils exists mainly to stabilize GNU-sensitive build environments. Theo de Raadt went further arguing that nobody wants subtly differently-behaving utilities in their pipelines and that ports developers would be stuck maintaining the result.","submitter_user":"spikewall","user_is_author":false,"tags":["openbsd","rust"],"short_id_url":"https://lobste.rs/s/vmmq7g","comments_url":"https://lobste.rs/s/vmmq7g/openbsd_s_ports_tree_keeps_gpl_coreutils"},{"short_id":"zyzrlh","created_at":"2026-09-30T00:05:56.191-05:00","title":"Dirty Optimization Secrets (C for Playdate)","url":"https://devforum.play.date/t/dirty-optimization-secrets-c-for-playdate/23011","score":3,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"strugee","user_is_author":false,"tags":["hardware"],"short_id_url":"https://lobste.rs/s/zyzrlh","comments_url":"https://lobste.rs/s/zyzrlh/dirty_optimization_secrets_c_for"},{"short_id":"e2gxro","created_at":"2026-09-29T23:05:15.115-05:00","title":"Fake Express Packages on npm Spread a Lin