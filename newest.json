[{"short_id":"miwcai","created_at":"2026-10-16T18:53:05.634-05:00","title":"Do you let LLMs write both your tests and your code?","url":"","score":3,"flags":0,"comment_count":0,"description":"\u003cp\u003eI'm curious what stance others have taken? Or what they've experienced with this? I'm toying with adding a rule to our values.md that the LLM can only significantly generate one or the other.\u003c/p\u003e\n\u003cp\u003eI'm reviewing a merge request at the moment where it's clear the LLM mostly did both, and they're highly tautological. And I can see how it over engineered the code, just to be able to write more tests almost.\u003c/p\u003e\n","description_plain":"I'm curious what stance others have taken? Or what they've experienced with this? I'm toying with adding a rule to our values.md that the LLM can only significantly generate one or the other.\r\n\r\nI'm reviewing a merge request at the moment where it's clear the LLM mostly did both, and they're highly tautological. And I can see how it over engineered the code, just to be able to write more tests almost.","submitter_user":"travisgriggs","user_is_author":true,"tags":["vibecoding"],"short_id_url":"https://lobste.rs/s/miwcai","comments_url":"https://lobste.rs/s/miwcai/do_you_let_llms_write_both_your_tests_your"},{"short_id":"kufmuy","created_at":"2026-10-16T18:06:35.961-05:00","title":"How the Claude Code team does code review","url":"https://claude.dev/blog/solving-code-review-at-anthropic/","score":-1,"flags":2,"comment_count":0,"description":"","description_plain":"","submitter_user":"kaycebasques","user_is_author":false,"tags":["practices","vibecoding"],"short_id_url":"https://lobste.rs/s/kufmuy","comments_url":"https://lobste.rs/s/kufmuy/how_claude_code_team_does_code_review"},{"short_id":"wzgadv","created_at":"2026-10-16T15:49:12.465-05:00","title":"There's never been a better time to go into math","url":"https://www.youtube.com/watch?v=LKrwhjOI8Nc","score":3,"flags":0,"comment_count":3,"description":"