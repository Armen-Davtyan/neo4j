[{"short_id":"koipdp","created_at":"2026-10-18T11:10:47.504-05:00","title":"The Problem with C++ Safety: Why “It Works” Isn’t Good Enough","url":"https://www.modernescpp.com/index.php/cpp-and-memory-safety-part-1/","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"raymii","user_is_author":false,"tags":["c++"],"short_id_url":"https://lobste.rs/s/koipdp","comments_url":"https://lobste.rs/s/koipdp/problem_with_c_safety_why_it_works_isn_t"},{"short_id":"u8vxmz","created_at":"2026-10-18T09:52:34.682-05:00","title":"Using timers to perform weekly tasks","url":"https://mbork.pl/2026-10-17_Using_timers_to_perform_weekly_tasks","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"7tehdt3cnw6kir6o","user_is_author":false,"tags":["emacs"],"short_id_url":"https://lobste.rs/s/u8vxmz","comments_url":"https://lobste.rs/s/u8vxmz/using_timers_perform_weekly_tasks"},{"short_id":"np6czp","created_at":"2026-10-18T09:36:52.682-05:00","title":"High performance policy routed IPsec mesh SD-WAN","url":"https://ranet3.com/","score":6,"flags":0,"comment_count":1,"description":"","description_plain":"","submitter_user":"ysun","user_is_author":true,"tags":["networking"],"short_id_url":"https://lobste.rs/s/np6czp","comments_url":"https://lobste.rs/s/np6czp/high_performance_policy_routed_ipsec"},{"short_id":"vwgrix","created_at":"2026-10-18T09:29:16.035-05:00","title":"A New Way to Think About Borrow Checking (In Reverse)","url":"https://verdagon.dev/blog/reverse-borrow-checking","score":10,"flags":0,"comment_count":1,"description":"","description_plain":"","submitter_user":"Verdagon","user_is_author":true,"tags":["compilers"],"short_id_url":"https://lobste.rs/s/vwgrix","comments_url":"https://lobste.rs/s/vwgrix/new_way_think_about_borrow_checking"},{"short_id":"mmvhup","created_at":"2026-10-18T07:48:02.112-05:00","title":"ARP! Tell your network to explain itself","url":"https://benjcal.space/blog/arp-tell-your-network-to-explain-itself/","score":11,"flags":0,"comment_count":7,"description":"","description_plain":"","submitter_user":"benj","user_is_author":true,"tags":["networking"],"short_id_url":"https://lobste.rs/s/mmvhup","comments_url":"https://lobste.rs/s/mmvhup/arp_tell_your_network_explain_itself"},{"short_id":"kiq0si","created_at":"2026-10-18T07:06:05.111-05:00","title":"Algorithmic Sound Design with L-Systems and Granular Synthesis","url":"https://nathanho.me/posts/evograin/","score":6,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"chrisl","user_is_author":false,"tags":["art","programming"],"short_id_url":"https://lobste.rs/s/kiq0si","comments_url":"https://lobste.rs/s/kiq0si/algorithmic_sound_design_with_l_systems"},{"short_id":"ggpwfi","created_at":"2026-10-18T05:35:11.525-05:00","title":"It's enough - vibecoding tag crossed from useless to harmful","url":"","score":151,"flags":3,"comment_count":162,"description":"\u003cp\u003eThe vibecoding tag has been getting more and more useless for a while now. It lost the original meaning as the culture of software engineering with LLMs matured a bit. It got silly when posts talking about LLMs in general got tagged. It got useless when posts even mentioning some project created with LLMs in passing got tagged. Now it actually got harmful to the community when tagging posts turns away very valuable members \u003ca href=\"https://lobste.rs/c/vecuxj\" rel=\"ugc\"\u003ehttps://lobste.rs/c/vecuxj\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eI sighed and moved on for a while now as almost everything gets tagged - you can skip a word. But now it not only carries no signal whatsoever, it turns away people creating original technical content - which is what I assume anti-vibecoding people would actually like to see more of.\u003c/p\u003e\n\u003cp\u003ePlease split it or kill it. But we'd be better off without what exists today.\u003c/p\u003e\n\u003cp\u003eAdded: To be clear, I totally support people filtering out llm-generated or llm-centric posts. But right now everyone loses. And every day we lose a little bit more. Whether it's an original, interesting article that turns out to be nth-degree related to llms and filtered out, or a community member annoyed by this recurring problem and leaving us with even fewer actual non-llm-centric entries.\u003c/p\u003e\n","description_plain":"The vibecoding tag has been getting more and more useless for a while now. It lost the original meaning as the culture of software engineering with LLMs matured a bit. It got silly when posts talking about LLMs in general got tagged. It got useless when posts even mentioning some project created with LLMs in passing got tagged. Now it actually got harmful to the community when tagging posts turns away very valuable members https://lobste.rs/c/vecuxj\r\n\r\nI sighed and moved on for a while now as almost everything gets tagged - you can skip a word. But now it not only carries no signal whatsoever, it turns away people creating original technical content - which is what I assume anti-vibecoding people would actually like to see more of.\r\n\r\nPlease split it or kill it. But we'd be better off without what exists today.\r\n\r\nAdded: To be clear, I totally support people filtering out llm-generated or llm-centric posts. But right now everyone loses. And every day we lose a little bit more. Whether it's an original, interesting article that turns out to be nth-degree related to llms and filtered out, or a community member annoyed by this recurring problem and leaving us with even fewer actual non-llm-centric entries.","submitter_user":"viraptor","user_is_author":true,"tags":["meta","vibecoding"],"short_id_url":"https://lobste.rs/s/ggpwfi","comments_url":"https://lobste.rs/s/ggpwfi/it_s_enough_vibecoding_tag_crossed_from"},{"short_id":"gl8yly","created_at":"2026-10-18T02:42:41.212-05:00","title":"Un-hanging the HP Envy 17-DA0013dx for OpenBSD","url":"https://darwinsys.com/blog/