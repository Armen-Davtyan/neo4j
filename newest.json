[{"short_id":"odnnzh","created_at":"2026-11-10T13:51:19.139-06:00","title":"Searching for pedagogical materials on memory models","url":"","score":1,"flags":0,"comment_count":0,"description":"\u003cp\u003eHi folks,\u003c/p\u003e\n\u003cp\u003eI'm working on some supplementary materials for a course I'm TAing, my university's version of operating systems, that involves students developing an OS targeting a Raspberry Pi 3B+. One of the topics I'm trying to get at is strong and weak memory models (and why ARM has so many weird data/instruction buffer synchronization things students have to do when writing an MMU), so if you have any excellent example articles/passages/blogs on memory models that have helped you, please comment them so I can take a look!\u003c/p\u003e\n\u003cp\u003eThanks!\u003c/p\u003e\n","description_plain":"Hi folks,\r\n\r\nI'm working on some supplementary materials for a course I'm TAing, my university's version of operating systems, that involves students developing an OS targeting a Raspberry Pi 3B+. One of the topics I'm trying to get at is strong and weak memory models (and why ARM has so many weird data/instruction buffer synchronization things students have to do when writing an MMU), so if you have any excellent example articles/passages/blogs on memory models that have helped you, please comment them so I can take a look!\r\n\r\nThanks!","submitter_user":"spoonmilk","user_is_author":true,"tags":["ask","osdev"],"short_id_url":"https://lobste.rs/s/odnnzh","comments_url":"https://lobste.rs/s/odnnzh/searching_for_pedagogical_materials_on"},{"short_id":"plreds","created_at":"2026-11-10T13:44:50.546-06:00","title":"Memory Safety Bugs in Rust Standard Library","url":"https://forge-blog.github.io/posts/rust-std-memory-safety/","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"expurple","user_is_author":false,"tags":["rust"],"short_id_url":"https://lobste.rs/s/plreds","comments_url":"https://lobste.rs/s/