[{"short_id":"ibtc9r","created_at":"2026-10-08T16:45:09.893-05:00","title":"Rolling the Root Key (Update)","url":"https://ispcol.potaroo.net/2026-10/kskroll.html","score":2,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"robalex","user_is_author":false,"tags":["networking"],"short_id_url":"https://lobste.rs/s/ibtc9r","comments_url":"https://lobste.rs/s/ibtc9r/rolling_root_key_update"},{"short_id":"kfla2w","created_at":"2026-10-08T16:39:50.616-05:00","title":"Demoting i686 Windows targets to std-only","url":"https://blog.rust-lang.org/2026/10/02/demoting-i686-windows-targets-to-std-only/","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"madsmtm","user_is_author":false,"tags":["rust","windows"],"short_id_url":"https://lobste.rs/s/kfla2w","comments_url":"https://lobste.rs/s/kfla2w/demoting_i686_windows_targets_std_only"},{"short_id":"dcrosf","created_at":"2026-10-08T14:06:25.805-05:00","title":"64-Day Certificate Lifetimes Coming Feb 2027","url":"https://letsencrypt.org/2026/10/07/64-day-certs.html","score":9,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"fanf","user_is_author":false,"tags":["devops","security"],"short_id_url":"https://lobste.rs/s/dcrosf","comments_url":"https://lobste.rs/s/dcrosf/64_day_certificate_lifetimes_coming_feb"},{"short_id":"zxegbr","created_at":"2026-10-08T13:55:58.392-05:00","title":"Please Let Me Contact You Privately","url":"https://kennyqin.com/please-let-me-contact-you-privately/","score":1,"flags":0,"comment_count":2,"description":"","description_plain":"","submitter_user":"nrvous","user_is_author":false,"tags":["email","web"],"short_id_url":"https://lobste.rs/s/zxegbr","comments_url":"https://lobste.rs/s/zxegbr/please_let_me_contact_you_privately"},{"short_id":"gliabr","created_at":"2026-10-08T12:39:17.826-05:00","title":"Scaling and benchmarking a critical message bus using a new indexing strategy","url":"https://blog.janestreet.com/scaling-and-benchmarking-a-critical-message-bus/","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"eatonphil","user_is_author":false,"tags":["distributed"],"short_id_url":"https://lobste.rs/s/gliabr","comments_url":"https://lobste.rs/s/gliabr/scaling_benchmarking_critical_message"},{"short_id":"axmhji","created_at":"2026-10-08T12:16:42.874-05:00","title":"Navier-Stokes lost in translation: Why Lean verification of AI autoformalisation does not guarantee correct natural language proofs","url":"https://arxiv.org/abs/2610.08144","score":10,"flags":0,"comment_count":4,"description":"\u003cp\u003eAutoformalisation is increasingly used to verify mathematical texts, including those generated by AI, as in OpenAI's announced proof of blow-up of solutions to the Navier-Stokes equations. In this process, an AI system translates the text from a natural language (NL) into a formal language such as Lean. Once this translation is done, the argument expressed in the formal language can easily be mechanically verified. The purpose of this article is to demonstrate why this process may offer no confidence in the original NL argument, owing to the various difficulties in performing the translation semantically faithfully. In particular, we highlight that the problem of resolving ambiguities in mathematical NL text, which is necessary in order to provide semantically faithful translation, is arbitrarily high up in the Solvability Complexity Index (SCI) hierarchy/arithmetical hierarchy (the SCI = ∞). Hence, informally, providing semantically faithful AI autoformalisation is harder than any computational problem including the Halting problem (which has SCI = 1). To demonstrate the effect of this result we provide several examples of AI mistranslations of NL statements and proofs into Lean in practice, resulting in mismatches between NL proofs and their Lean \"verifications\". These include OpenAI's announced Navier-Stokes proof. In particular, we show that the formalised Lean proof does not correspond to the NL proof of blow-up of solutions to the Navier-Stokes equations.\u003c/p\u003e\n","description_plain":"Autoformalisation is increasingly used to verify mathematical texts, including those generated by AI, as in OpenAI's announced proof of blow-up of solutions to the Navier-Stokes equations. In this process, an AI system translates the text from a natural language (NL) into a formal language such as Lean. Once this translation is done, the argument expressed in the formal language can easily be mechanically verified. The purpose of this article is to demonstrate why this process may offer no confidence in the original NL argument, owing to the various difficulties in performing the translation semantically faithfully. In particular, we highlight that the problem of resolving ambiguities in mathematical NL text, which is necessary in order to provide semantically faithful translation, is arbitrarily high up in the Solvability Complexity Index (SCI) hierarchy/arithmetical hierarchy (the SCI = ∞). Hence, informally, providing semantically faithful AI autoformalisation is harder than any computational problem including the Halting problem (which has SCI = 1). To demonstrate the effect of this result we provide several examples of AI mistranslations of NL statements and proofs into Lean in practice, resulting in mismatches between NL proofs and their Lean \"verifications\". These include OpenAI's announced Navier-Stokes proof. In particular, we show that the formalised Lean proof does not correspond to the NL proof of blow-up of solutions to the Navier-Stokes equations.","submitter_user":"Corbin","user_is_author":false,"tags":["formalmethods","math","pdf","reversing","vibecoding"],"short_id_url":"https://lobste.rs/s/axmhji","comments_url":"https://lobste.rs/s/axmhji/navier_stokes_lost_translation_why_lean"},{"short_id":"q3n06u","created_at":"2026-10-08T11:53:38.450-05:00","title":"Unison 1.5.0 released with support for GADTs","url":"https://github.com/unisonweb/unison/releases/tag/release%2F1.5.0","score":1,"flags":1,"comment_count":0,"description":"\u003cp\u003eHere are the official docs for \u003ca href=\"https://www.unison-lang.org/docs/fundamentals/data-types/gadts\" rel=\"ugc\"\u003eGADTs\u003c/a\u003e and \u003ca href=\"https://www.unison-lang.org/docs/fundamentals/abilities/indexed-abilities\" rel=\"ugc\"\u003eindexed abilities\u003c/a\u003e.\u003c/p\u003e\n","description_plain":"Here are the official docs for [GADTs](https://www.unison-lang.org/docs/fundamentals/data-types/gadts) and [indexed abilities](https://www.unison-lang.org/docs/fundamentals/abilities/indexed-abilities).","submitter_user":"skykanin","user_is_author":false,"tags":["plt","release"],"short_id_url":"https://lobste.rs/s/q3n06u","comments_url":"https://lobste.rs/s/q3n06u/unison_1_5_0_released_with_support_for"},{"short_id":"8s4rbw","created_at":"2026-10-08T10:17:11.997-05:00","title":"Lustre, Mist, and BEAM messages","url":"https://blog.guillheu.dev/articles/lustre-mist-and-beam-messages/","score":2,"flags":1,"comment_count":0,"description":"","description_plain":"","submitter_user":"crowdhailer","user_is_author":false,"tags":["gleam"],"short_id_url":"https://lobste.rs/s/8s4rbw","comments_url":"https://lobste.rs/s/8s4rbw/lustre_mist_beam_messages"},{"short_id":"aco14q","created_at":"2026-10-08T10:02:28.693-05:00","title":"The history of the Hetzner Cloud network stack","url":"https://www.hetzner.com/blog/the-hetzner-cloud-network-stack-history-and-technical-overview/","score":10,"flags":0,"comment_count":1,"description":"","description_plain":"","submitter_user":"eatonphil","user_is_author":false,"tags":["networking"],"short_id_url":"https://lobste.rs/s/aco14q","comments_url":"https://lobste.rs/s/aco14q/history_hetzner_cloud_network_stack"},{"short_id":"ly4io4","created_at":"2026-10-08T10:01:37.747-05:00","title":"Automata and Flowers","url":"https://luisacicolini.git