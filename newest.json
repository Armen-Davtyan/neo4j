[{"short_id":"0htvw0","created_at":"2026-09-07T03:31:19.589-05:00","title":"\"Hammock Driven Development\" (2010)","url":"https://youtu.be/f84n5oFoZBc","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"gunduzc","user_is_author":false,"tags":["practices","video"],"short_id_url":"https://lobste.rs/s/0htvw0","comments_url":"https://lobste.rs/s/0htvw0/hammock_driven_development_2010"},{"short_id":"mqbqbz","created_at":"2026-09-07T01:52:49.681-05:00","title":"Internationalization and Localization","url":"https://www.kashyapsuhas.com/blog/i18n-l10n","score":3,"flags":0,"comment_count":2,"description":"","description_plain":"","submitter_user":"abhin4v","user_is_author":false,"tags":["web"],"short_id_url":"https://lobste.rs/s/mqbqbz","comments_url":"https://lobste.rs/s/mqbqbz/internationalization_localization"},{"short_id":"qsjwv4","created_at":"2026-09-07T00:04:28.395-05:00","title":"Posting about online presentations","url":"","score":2,"flags":0,"comment_count":3,"description":"\u003cp\u003eI organize online presentations about various topics in computing. (e.g. Python, Rust, Go, Databases, DevOps etc.) I also monitor many other channels that have online \"meetups\". Even if they don't use Meetup to organize them.\u003c/p\u003e\n\u003cp\u003eI am new here and I would like to get the opinion of the community here.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eWould it be interesting and acceptable to post such events?\u003c/li\u003e\n\u003cli\u003eWould it be considered self promotion if I post about events that I organize, but that features other people as speakers?\u003c/li\u003e\n\u003cli\u003eShould these post be one post per event or lists of events. eg. \"Online Python events in the next 10 days\"?\u003c/li\u003e\n\u003c/ul\u003e\n","description_plain":"I organize online presentations about various topics in computing. (e.g. Python, Rust, Go, Databases, DevOps etc.) I also monitor many other channels that have online \"meetups\". Even if they don't use Meetup to organize them.\r\n\r\nI am new here and I would like to get the opinion of the community here.\r\n\r\n* Would it be interesting and acceptable to post such events?\r\n* Would it be considered self promotion if I post about events that I organize, but that features other people as speakers?\r\n* Should these post be one post per event or lists of events. eg. \"Online Python events in the next 10 days\"?","submitter_user":"szabgab","user_is_author":true,"tags":["event"],"short_id_url":"https://lobste.rs/s/qsjwv4","comments_url":"https://lobste.rs/s/qsjwv4/posting_about_online_presentations"},{"short_id":"9i5qo4","created_at":"2026-09-06T22:08:41.354-05:00","title":"slop lasagna","url":"https://underreacted.leaflet.pub/3mdjygm2p5s2c","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"carlana","user_is_author":false,"tags":["vibecoding"],"short_id_url":"https://lobste.rs/s/9i5qo4","comments_url":"https://lobste.rs/s/9i5qo4/slop_lasagna"},{"short_id":"xxeyrk","created_at":"2026-09-06T21:54:47.267-05:00","title":"Real-Time Fluid Dynamics for Games","url":"https://www.researchgate.net/publication/2560062_Real-Time_Fluid_Dynamics_for_Games","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"juliethefoxcoon","user_is_author":false,"tags":["games","graphics","pdf"],"short_id_url":"https://lobste.rs/s/xxeyrk","comments_url":"https://lobste.rs/s/xxeyrk/real_time_fluid_dynamics_for_games"},{"short_id":"eoaw1h","created_at":"2026-09-06T21:15:34.181-05:00","title":"PL Education in the Age of AI: Interview with Shriram Krishnamurthi","url":"https://www.typetheoryforall.com/episodes/pl-education-in-the-age-of-ai","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"gnyeki","user_is_author":false,"tags":["audio","education","plt"],"short_id_url":"https://lobste.rs/s/eoaw1h","comments_url":"https://lobste.rs/s/e