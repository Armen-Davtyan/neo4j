[{"short_id":"0evm15","created_at":"2026-11-24T13:56:25.566-06:00","title":"Splitting USB-C: USB 3 and USB 2 on One Port","url":"https://frankchiarulli.com/blog/splitting-usb-c/","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"fanf","user_is_author":false,"tags":["hardware"],"short_id_url":"https://lobste.rs/s/0evm15","comments_url":"https://lobste.rs/s/0evm15/splitting_usb_c_usb_3_usb_2_on_one_port"},{"short_id":"beyzsq","created_at":"2026-11-24T12:45:22.924-06:00","title":"The \"Security Tax\": Reclaiming 30% Performance in WSL 2","url":"https://tonym.us/wsl2-security-tax-reclaiming-performance","score":0,"flags":2,"comment_count":0,"description":"\u003cp\u003eA significant WSL2 performance issue I wrote about in march now has a better RCA and reproduction steps.  You can get 50+% better build performance with kernelCommandLine=spec_rstack_overflow=off\u003c/p\u003e\n\u003cp\u003esee also\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://github.com/microsoft/WSL/issues/41827\" rel=\"ugc\"\u003ehttps://github.com/microsoft/WSL/issues/41827\u003c/a\u003e\u003c/p\u003e\n","description_plain":"A significant WSL2 performance issue I wrote about in march now has a better RCA and reproduction steps.  You can get 50+% better build performance with kernelCommandLine=spec_rstack_overflow=off\r\n\r\nsee also \r\n\r\nhttps://github.com/microsoft/WSL/issues/41827","submitter_user":"tonymet","user_is_author":true,"tags":["linux","performance","security","virtualization"],"short_id_url":"https://lobste.rs/s/beyzsq","comments_url":"https://lobste.rs/s/beyzsq/security_tax_reclaiming_30_performance"},{"short_id":"vciex6","created_at":"2026-11-24T12:37:29.366-06:00","title":"9/UX: a Macintosh-inspired desktop for 9front","url":"https://progrium.github.io/9ux/","score":2,"flags":1,"comment_count":0,"description":"\u003cp\u003eI have written a story about this on the Register, but of course I can't post that here.\u003c/p\u003e\n\u003cp\u003eI think this is a quite astonishing effort and could make 9front \u003cem\u003econsiderably\u003c/em\u003e more usable... but it's bot-assisted, so I don't think they'll take it.\u003c/p\u003e\n","description_plain":"I have written a story about this on the Register, but of course I can't post that here.\r\n\r\nI think this is a quite astonishing effort and could make 9front _considerably_ more usable... but it's bot-assisted, so I don't think they'll take it.","submitter_user":"lproven","user_is_author":false,"tags":["ai","osdev"],"short_id_url":"https://lobste.rs/s/vciex6","comments_url":"https://lobste.rs/s/vciex6/9_ux_macintosh_inspired_desktop_for"},{"short_id":"mcrzxl","created_at":"2026-11-24T12:27:49.682-06:00","title":"Fund browser-grade certificate checking for every TLS client","url":"https://upki.rustls.dev/funding.html","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"wofo","user_is_author":false,"tags":["cryptography","programming"],"short_id_url":"https://lobste.rs/s/mcrzxl","comments_url":"https://lobste.rs/s/mcrzxl/fund_browser_grade_certificate_checking"},{"short_id":"m7gqr6","created_at":"2026-11-24T12:11:49.469-06:00","title":"Per Vognsen on the effect of AVX-512 on lexing and parsing","url":"https://mastodon.social/@pervognsen/117668394962974183","score":9,"flags":0,"comment_count":4,"description":"","description_plain":"","submitter_user":"dvogel","user_is_author":false,"tags":["compilers","performance"],"short_id_url":"https://lobste.rs/s/m7gqr6","comments_url":"https://lobste.rs/s/m7gqr6/per_vognsen_on_effect_avx_512_on_lexing"},{"short_id":"y56k2b","created_at":"2026-11-24T11:45:29.085-06:00","title":"Beyond Linux: A Journey Through the Open Source Ecosystem","url":"https://it-notes.dragas.net/2026/11/17/beyond-linux-a-journey-through-the-open-source-ecosystem/","score":3,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"abnercoimbre","user_is_author":false,"tags":["freebsd","netbsd","openbsd"],"short_id_url":"https://lobste.rs/s/y56k2b","comments_url":"https://lobste.rs/s/y56k2b/beyond_linux_journey_through_open_source"},{"short_id":"qrhnbc","created_at":"2026-11-24T11:19:10.765-06:00","title":"Go Without Wires: TinyGo on ESP32","url":"https://www.youtube.com/watch?v=Vi5M-uD2x_U","score":3,"flags":0,"comment_count":0,"description":"\u003cp\u003e[edited to call out the connection to TinyFlight first thing, since the YouTube title doesn't call it out]\u003c/p\u003e\n\u003cp\u003eI originally tried to submit the URL for the Github project, \u003ca href=\"https://github.com/hybridgroup/tinyflight\" rel=\"ugc\"\u003ehttps://github.com/hybridgroup/tinyflight\u003c/a\u003e, but was thwarted by submission system.\u003c/p\u003e\n\u003cp\u003eI wanted to call attention to the project because it is very \u003cem\u003enicely documented\u003c/em\u003e, full of clear (to me, an intermediate gopher) examples of TinyGo code to interact with devices, handle multicore concurrency on an MCU, and build a testable design for a microcontroller application.  Started off with \u003ca href=\"https://github.com/hybridgroup/tinyflight/blob/main/docs/architecture.md\" rel=\"ugc\"\u003ethe architecture doc\u003c/a\u003e and have been reading and playing happy.  I really appreciate the documentation effort.\u003c/p\u003e\n\u003cp\u003eDo folks have other small-enough-to-swallow-but-big-enough-to-be-real projects that helped them move up the learning ladder?\u003c/p\u003e\n\u003cp\u003e(It's also a cool project in its own right, my Stampfly is in the mail)\u003c/p\u003e\n","description_plain":"[edited to call out the connection to TinyFlight first thing, since the YouTube title doesn't call it out]\r\n\r\nI originally tried to submit the URL for the Github project, https://github.com/hybridgroup/tinyflight, but was thwarted by submission system.\r\n\r\nI wanted to call attention to the project because it is very *nicely documented*, full of clear (to me, an intermediate gopher) examples of TinyGo code to interact with devices, handle multicore concurrency on an MCU, and build a testable design for a microcontroller application.  Started off with [the architecture doc](https://github.com/hybridgroup/tinyflight/blob/main/docs/architecture.md) and have been reading and playing happy.  I really appreciate the documentation effort.\r\n\r\nDo folks have other small-enough-to-swallow-but-big-enough-to-be-real projects that helped them move up the learning ladder?\r\n\r\n(It's also a cool project in its own right, my Stampfly is in the mail)","submitter_user":"hartzell","user_is_author":false,"tags":["go","video"],"short_id_url":"https://lobste.rs/s/qrhnbc","comments_url":"https://lobste.rs/s/qrhnbc/go_without_wires_tinygo_on_esp32"},{"short_id":"w3zni2","created_at":"2026-11-24T10:35:47.557-06:00","title":"SeaStore: Redesigning Ceph’s Storage Backend for CPU-Efficient NVMe Performance","url":"https://dl.acm.org/doi/10.1145/3828523.3857112","score":3,"flags":0,"comment_count":1,"description":"","description_plain":"","submitter_user":"shraddhaag","user_is_author":false,"tags":["databases"],"short_id_url":"https://lobste.rs/s/w3zni2","comments_url":"https://lobste.rs/s/w3zni2/seastore_redesigning_ceph_s_storage"},{"short_id":"xst6fv","created_at":"2026-11-24T10:26:44.055-06:00","title":"Nightmare mode: simulating disk failures","url":"https://antithesis.com/blog/2026/nightmare-mode/","score":4,"flags":1,"comment_count":0,"description":"","description_plain":"","submitter_user":"eatonphil","user_is_author":false,"tags":["osdev","testing"],"short_id_url":"https://lobste.rs/s/xst6fv","comments_url":"https://lobste.rs/s/xst6fv/nightmare_mode_simulating_disk_failures"},{"short_id":"yyktrz","created_at":"2026-11-24T09:22:24.477-06:00","title":"I checked Clojure's core with Lean and found 17 unreported bugs","url":"https://s.conao3.com/blog/2026/e4f733","score":23,"flags":0,"comment_count":1,"description":"","description