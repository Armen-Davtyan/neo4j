[{"short_id":"yervw7","created_at":"2026-11-15T17:05:45.490-06:00","title":"This Month in Redox - October 2026","url":"https://www.redox-os.org/news/this-month-261031/","score":2,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"gnafuthegreat","user_is_author":false,"tags":["osdev","rust"],"short_id_url":"https://lobste.rs/s/yervw7","comments_url":"https://lobste.rs/s/yervw7/this_month_redox_october_2026"},{"short_id":"hgicaq","created_at":"2026-11-15T16:44:13.886-06:00","title":"Please Implement A Quorum Database","url":"https://transactional.blog/talk/please-implement-a-quorum-database","score":2,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"eatonphil","user_is_author":false,"tags":["databases","distributed"],"short_id_url":"https://lobste.rs/s/hgicaq","comments_url":"https://lobste.rs/s/hgicaq/please_implement_quorum_database"},{"short_id":"dxxvek","created_at":"2026-11-15T16:39:34.065-06:00","title":"A datetime library for Rust","url":"https://burntsushi.net/jiff/","score":15,"flags":0,"comment_count":4,"description":"","description_plain":"","submitter_user":"refi64","user_is_author":false,"tags":["rust"],"short_id_url":"https://lobste.rs/s/dxxvek","comments_url":"https://lobste.rs/s/dxxvek/datetime_library_for_rust"},{"short_id":"ghijzd","created_at":"2026-11-15T15:19:52.052-06:00","title":"Strata — memory is explicit I/O","url":"https://yrashk.com/strata/","score":-2,"flags":5,"comment_count":0,"description":"\u003cp\u003eI've long thought about how we're influenced by CPU architectures, and importantly, their ISAs.\nIn a discussion at a meetup, I brought up a topic that interested me for a while: how would an ISA that exposes memory and cache interactions in a more explicit way (because if you think about it, memory is very much I/O), as opposed to being smart and predictive on its own?\u003c/p\u003e\n\u003cp\u003eAn obscure interest, of course. Nevertheless, I wanted to build a quick prototype after that.\u003c/p\u003e\n\u003cp\u003eWhat ended up transpiring was a bit larger. A multicore architecture with tiered stores, capabilities, a JIT'd emulator, Verilog RTL with a simulator, a small microkernel OS, UI, JIT Forth, an assembler in its own assembly, a bootstrapping C99 compiler, a few games, a visual debugger, and a few other things.\u003c/p\u003e\n\u003cp\u003e(This also shows just how far a directed LLM process can go in little time)\u003c/p\u003e\n","description_plain":"I've long thought about how we're influenced by CPU architectures, and importantly, their ISAs.\r\nIn a discussion at a meetup, I brought up a topic that interested me for a while: how would an ISA that exposes memory and cache interactions in a more explicit way (because if you think about it, memory is very much I/O), as opposed to being smart and predictive on its own?\r\n\r\nAn obscure interest, of course. Nevertheless, I wanted to build a quick prototype after that.\r\n\r\nWhat ended up transpiring was a bit larger. A multicore architecture with tiered stores, capabilities, a JIT'd emulator, Verilog RTL with a simulator, a small microkernel OS, UI, JIT Forth, an assembler in its own assembly, a bootstrapping C99 compiler, a few games, a visual debugger, and a few other things.\r\n\r\n(This also shows just how far a directed LLM process can go in little time)","submitter_user":"yrashk","user_is_author":true,"tags":["assembly","c","concatenative","hardware","osdev","show","wasm"],"short_id_url":"https://lobste.rs/s/ghijzd","comments_url":"https://lobste.rs/s/ghijzd/strata_memory_is_explicit_i_o"},{"short_id":"9haygb","created_at":"2026-11-15T15:19:35.897-06:00","title":"clice v1.0 Released: Welcome to Modern C++","url":"https://www.ykiko.me/en/articles/2105384023094834022/","score":3,"flags":0,"comment_count":1,"description":"","description_plain":"","submitter_user":"jeaye","user_is_author":false,"tags":["c++","compilers"],"short_id_url":"https://lobste.rs/s/9haygb","